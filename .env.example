# ==============================================================================
# SmartBook — Environment Configuration Template
# Copy this file to .env and configure values for your target deployment.
# ==============================================================================

# Application Environment: 'production' | 'development' | 'testing'
FLASK_ENV=production
FLASK_DEBUG=0

# Secret Key for session signing and CSRF tokens (Use a 32+ character random string)
SECRET_KEY=replace-with-a-very-strong-cryptographically-random-secret-key-in-prod

# Server Port (Defaults to 5000)
PORT=5000

# ==============================================================================
# Database Configuration
# ==============================================================================
# Option 1: MySQL (Recommended for Production)
MYSQL_USER=smartbook_user
MYSQL_PASSWORD=replace_with_secure_mysql_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=smartbook_db

# Option 2: Direct Connection String (e.g., AWS RDS, DigitalOcean, PlanetScale)
# DATABASE_URL=mysql+pymysql://smartbook_user:replace_with_secure_mysql_password@localhost:3306/smartbook_db?charset=utf8mb4

# Option 3: If no MySQL credentials or DATABASE_URL provided, SQLite is used automatically
# SQLALCHEMY_DATABASE_URI=sqlite:///smartbook.db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=280

# ==============================================================================
# Security & Cookie Settings
# ==============================================================================
# Set to 'true' in production when running behind HTTPS/SSL
SESSION_COOKIE_SECURE=true

# Seeding Options: Set to 'false' in production to avoid inserting demo user account
SEED_DEMO_DATA=false
